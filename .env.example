# ─────────────────────────────────────────────────────────────────────────────
# Algo Lindo · variables de entorno
# Copiá este archivo a .env.local y completalo. .env.local NUNCA se commitea.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública de la app (back_urls de Mercado Pago y links de los mails)
APP_URL=http://localhost:3000

# true = el checkout muestra "Simular pago aprobado" y no usa Mercado Pago.
# false = usa Mercado Pago de verdad (con credenciales de prueba = sandbox).
DEMO_MODE=true

# Botón "Simulación" del header y página /simulacion. Poner false para producción.
NEXT_PUBLIC_SHOW_SIMULATION=true

# ── Base de datos ───────────────────────────────────────────────────────────
# Opción A (local, sin cuentas): Postgres embebido. Se crea solo en .data/pg.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/algolindo
EMBEDDED_POSTGRES=true
# Opción B (Supabase): Project Settings → Database → Connection string (URI, "Session pooler").
#   DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
#   EMBEDDED_POSTGRES=false

# Base para `npm test` (opcional). Si está vacía, los tests levantan su propio Postgres embebido.
TEST_DATABASE_URL=

# ── Supabase (opcional en local; necesario en producción) ──────────────────
# Si están completas se usan Supabase Auth (login del admin) y Storage (flyers).
# Si están vacías: login local con SEED_ADMIN_PASSWORD y flyers guardados en la base.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ───────────────────────────────────────────────────────────────────
# Mails con acceso a /admin, separados por coma.
ADMIN_EMAILS=admin@algolindo.test
# El seed crea (en Supabase Auth) el usuario del primer mail con esta contraseña.
# En modo local es directamente la contraseña del panel. Usá una larga.
SEED_ADMIN_PASSWORD=

# ── Entradas ────────────────────────────────────────────────────────────────
# Secreto para firmar los QR (mínimo 32 caracteres). Generalo con: openssl rand -hex 32
# Si lo cambiás, todas las entradas ya emitidas dejan de validar.
TICKET_HMAC_SECRET=

# ── Mercado Pago (solo con DEMO_MODE=false) ─────────────────────────────────
# Access token de PRUEBA: Tus integraciones → tu app → Credenciales de prueba.
MP_ACCESS_TOKEN=
# Opcional: clave secreta de Webhooks para validar el header x-signature.
MP_WEBHOOK_SECRET=

# ── Mails ───────────────────────────────────────────────────────────────────
# Sin RESEND_API_KEY los mails se imprimen en la consola y se guardan en .data/outbox/*.html
RESEND_API_KEY=
EMAIL_FROM=Algo Lindo <entradas@tudominio.com>

# Número de WhatsApp (formato internacional, sin + ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER=5491155550000
